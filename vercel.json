{
  "rewrites": [
    {
      "source": "/api/multiplayer/:path*",
      "destination": "/api/multiplayer?path=:path*"
    },
    {
      "source": "/api/analytics/:path*",
      "destination": "/api/analytics?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "17 3 * * *"
    }
  ]
}
